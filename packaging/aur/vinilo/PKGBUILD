# Maintainer: Daniel Miguel Tejedor
#
# Vinilo is a fork of Slipmat. Until this tree is tagged on its own remote,
# the source URL below still points at upstream Slipmat for reference.

pkgbase=vinilo
pkgname=('vinilo-daemon' 'vinilo' 'aguja')
pkgver=0.11.0
pkgrel=1
arch=('x86_64')          # Widevine on Linux is x86_64 only
url="https://github.com/SoftARV/Slipmat"
license=('GPL-3.0-or-later')
makedepends=('cargo' 'nodejs' 'npm' 'git' 'pkgconf' 'librsvg'
             'gtk4' 'libadwaita' 'libpulse' 'webkitgtk-6.0')
source=("$pkgbase-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ad026864baeea9d8f16b35539bbc903cda7df4c368962294167e3bd5115667d9')
options=('!debug' '!lto')

prepare() {
  cd "$srcdir/Vinilo-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  cd sidecar
  npm install --no-audit --no-fund
  node node_modules/electron/install.js
}

build() {
  cd "$srcdir/Vinilo-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen
}

check() {
  cd "$srcdir/Vinilo-$pkgver"
  cargo test --release --frozen
}

package_vinilo-daemon() {
  pkgdesc="Vinilo's playback daemon and hidden Chromium sidecar"
  depends=('gtk3' 'nss' 'alsa-lib' 'libcups' 'libxkbcommon' 'mesa' 'libdrm'
           'libseccomp' 'libpulse' 'yt-dlp' 'ffmpeg')

  cd "$srcdir/Vinilo-$pkgver"
  install -Dm755 target/release/vinilod "$pkgdir/usr/bin/vinilod"

  install -d "$pkgdir/usr/share/vinilo/sidecar"
  cp -r sidecar/package.json sidecar/main.js sidecar/preload.js \
        sidecar/queue-identity.js \
        sidecar/node_modules "$pkgdir/usr/share/vinilo/sidecar/"

  find "$pkgdir/usr/share/vinilo/sidecar" -name '*.node' \
    ! -name '*linux-x64-gnu*' -delete

  install -Dm644 packaging/systemd/vinilod.service \
    "$pkgdir/usr/lib/systemd/user/vinilod.service"
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}

package_vinilo() {
  pkgdesc="A native GNOME client for Apple Music"
  depends=("vinilo-daemon=$pkgver-$pkgrel"
           'gtk4' 'libadwaita' 'librsvg' 'hicolor-icon-theme' 'webkitgtk-6.0')

  cd "$srcdir/Vinilo-$pkgver"
  local appid=dev.danielmiguelt.Vinilo

  install -Dm755 target/release/vinilo "$pkgdir/usr/bin/vinilo"
  install -Dm644 "data/$appid.desktop" \
    "$pkgdir/usr/share/applications/$appid.desktop"
  install -Dm644 "data/icons/hicolor/scalable/apps/$appid.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/$appid.svg"
  install -Dm644 "data/icons/hicolor/symbolic/apps/$appid-symbolic.svg" \
    "$pkgdir/usr/share/icons/hicolor/symbolic/apps/$appid-symbolic.svg"
  install -Dm644 "data/icons/hicolor/symbolic/actions/vinilo-lyrics-symbolic.svg" \
    "$pkgdir/usr/share/icons/hicolor/symbolic/actions/vinilo-lyrics-symbolic.svg"

  for sz in 16 32 48 64 128 256 512; do
    install -d "$pkgdir/usr/share/icons/hicolor/${sz}x${sz}/apps"
    rsvg-convert -w "$sz" -h "$sz" "data/icons/hicolor/scalable/apps/$appid.svg" \
      -o "$pkgdir/usr/share/icons/hicolor/${sz}x${sz}/apps/$appid.png"
  done

  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

package_aguja() {
  pkgdesc="Winamp-style Apple Music in a terminal; needs a graphical session"
  depends=("vinilo-daemon=$pkgver-$pkgrel" 'libpulse' 'hicolor-icon-theme')

  cd "$srcdir/Vinilo-$pkgver"
  local appid=dev.danielmiguelt.Aguja

  install -Dm755 target/release/aguja "$pkgdir/usr/bin/aguja"
  install -Dm644 "data/$appid.desktop" \
    "$pkgdir/usr/share/applications/$appid.desktop"
  install -Dm644 "data/icons/hicolor/scalable/apps/$appid.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/$appid.svg"

  for sz in 16 32 48 64 128 256 512; do
    install -d "$pkgdir/usr/share/icons/hicolor/${sz}x${sz}/apps"
    rsvg-convert -w "$sz" -h "$sz" "data/icons/hicolor/scalable/apps/$appid.svg" \
      -o "$pkgdir/usr/share/icons/hicolor/${sz}x${sz}/apps/$appid.png"
  done

  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 crates/aguja/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
