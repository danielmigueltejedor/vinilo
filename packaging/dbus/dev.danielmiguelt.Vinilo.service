#
# GNOME matches this file's Name to the GtkApplication id. Without it, the
# app grid can try D-Bus activation, find nobody on the bus, and do nothing,
# while the same binary started from a terminal (which never goes through
# D-Bus activation) opens a window.
[D-BUS Service]
Name=dev.danielmiguelt.Vinilo
Exec=@BINDIR@/vinilo
