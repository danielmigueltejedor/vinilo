#
# GNOME matches this file's Name to the GtkApplication id. The Exec is the
# same wrapper as the .desktop file: D-Bus activation has no fish PATH and
# often no WAYLAND_DISPLAY, which is why a terminal worked and the icon did not.
[D-BUS Service]
Name=dev.danielmiguelt.Vinilo
Exec=@BINDIR@/vinilo-desktop
