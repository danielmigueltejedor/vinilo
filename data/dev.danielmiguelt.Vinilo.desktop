[Desktop Entry]
Type=Application
Name=Vinilo
Name[es]=Vinilo
GenericName=Music Player
GenericName[es]=Reproductor de música
Comment=Play Apple Music, and files on this computer, natively on Linux
Comment[es]=Reproduce Apple Music y archivos de este equipo de forma nativa en Linux
# @BINDIR@ is substituted at `make install`. A bare `vinilo` is why the
# launchpad did nothing: GNOME's session PATH does not include ~/.local/bin,
# which is where a prefix install puts the binary. The terminal did, because
# fish_add_path had added it there.
Exec=@BINDIR@/vinilo %U
TryExec=@BINDIR@/vinilo
# GNOME would otherwise D-Bus-activate by application id, miss the service,
# and show nothing — the terminal path never does that.
DBusActivatable=false
Icon=dev.danielmiguelt.Vinilo
Terminal=false
Categories=AudioVideo;Audio;Player;GTK;
MimeType=audio/mpeg;audio/flac;audio/ogg;audio/x-vorbis+ogg;audio/mp4;audio/aac;audio/x-wav;audio/wav;audio/x-ape;audio/x-musepack;inode/directory;
Keywords=Music;Apple;Player;Audio;Playlist;Streaming;Spotify;Tidal;
Keywords[es]=Música;Apple;Reproductor;Audio;Lista;Streaming;Spotify;Tidal;
StartupNotify=true
# The Wayland app_id, which GTK takes from the application id and not from the
# binary name. GNOME matches on this file's own id and never reads the line, so
# the old `vinilo` looked right there while every wlroots-style bar and
# taskbar failed to tie the window to this entry.
StartupWMClass=dev.danielmiguelt.Vinilo
X-GNOME-UsesNotifications=true
